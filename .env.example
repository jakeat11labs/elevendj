ELEVENLABS_API_KEY=
# 32-byte master key (base64) used to encrypt per-host ElevenLabs API keys at
# rest. Generate with: openssl rand -base64 32. Must be set in every environment.
ELEVENLABS_KEY_SECRET=
BLOB_READ_WRITE_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_ACCESS_TOKEN=
REQUEST_HASH_SECRET=
ENABLE_VERCEL_WORKFLOW=true
ENABLE_VERCEL_QUEUE=false
NEXT_PUBLIC_REALTIME_TOPIC=playlist:main
# Optional: generation model. Unset/anything = music_v2 (current flagship).
# Set to music_v1 to pin the legacy model.
MUSIC_MODEL=
# Optional: music audio output format codec_samplerate_bitrate (mp3 only).
# Unset = API default (mp3_44100_128, ~1MB/min). mp3_44100_64 ~halves blob size;
# mp3_44100_192 requires the host key to be Creator tier or above. Unknown
# values are ignored (fall back to the default).
MUSIC_OUTPUT_FORMAT=
# Optional: set to "true" to sign generated mp3s with C2PA content provenance.
MUSIC_SIGN_C2PA=

# Comma-separated emails granted super-admin (manage all hosts' sessions)
HOST_ADMIN_EMAILS=
