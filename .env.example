# === Required ===
# Neon Postgres connection string (pooled; used at runtime).
NEON_DATABASE_URL=
# Neon Auth. Cookie secret must be at least 32 characters.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# 32-byte master key (base64) used to encrypt per-host ElevenLabs API keys at
# rest. Generate with: openssl rand -base64 32. Must be set in every environment.
ELEVENLABS_KEY_SECRET=
# Vercel Blob read/write token (public audio playback).
BLOB_READ_WRITE_TOKEN=

# === Conditionally required ===
# Shared ElevenLabs key — used as the fallback for admin-hosted sessions that
# haven't connected their own key.
ELEVENLABS_API_KEY=
# Unpooled connection used by drizzle-kit for migrations (falls back to
# NEON_DATABASE_URL when unset).
NEON_DATABASE_URL_UNPOOLED=

# === Optional ===
# Comma-separated emails granted super-admin on first sign-in (bootstrap; the DB
# isAdmin flag is the source of truth thereafter).
ADMIN_EMAILS=
# Salt for hashed-IP rate limiting (falls back to NEON_AUTH_COOKIE_SECRET).
REQUEST_HASH_SECRET=
# Optional pepper for hashing integration/player credentials (falls back to
# NEON_AUTH_COOKIE_SECRET). Generate with: openssl rand -base64 32
AUTH_TOKEN_PEPPER=
# Generation runner gates. Workflow is on unless explicitly "false"; Queue is off
# unless explicitly "true". Otherwise generation runs via after().
ENABLE_VERCEL_WORKFLOW=true
ENABLE_VERCEL_QUEUE=false
# Absolute site URL for metadata/OG tags (defaults to the Vercel URL when unset).
NEXT_PUBLIC_SITE_URL=

# Optional: generation model. Unset/anything = music_v2 (current flagship).
# Set to music_v1 to pin the legacy model.
MUSIC_MODEL=
# Optional: music audio output format. Unset/"auto" picks the model-native
# format (Music v2: mp3_48000_192; v1: mp3_44100_128). Explicit 48 kHz choices:
# mp3_48000_128/192/240/320. Higher bitrates may require a paid host plan.
# Unknown values safely fall back to "auto".
MUSIC_OUTPUT_FORMAT=
# Optional: set to "true" to sign generated mp3s with C2PA content provenance.
MUSIC_SIGN_C2PA=
# Optional: set to "true" to retain generated songs server-side so their
# song_id is reusable for inpainting/remix. Enterprise-gated — leave off unless
# the host keys have inpainting access, or generation will fail.
MUSIC_STORE_FOR_INPAINTING=
# Optional: set to "false" to use the request's duration instead of auto length.
MUSIC_AUTO_DURATION=
